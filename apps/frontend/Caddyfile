# Serves the SPA *and* fronts the API on one origin. Railway terminates TLS at
# its edge and injects $PORT, so no automatic HTTPS and no admin endpoint here.
{
	admin off
	auto_https off
	persist_config off
}

:{$PORT:8080} {
	encode zstd gzip

	# The API, same-origin under /api. This is not a convenience: the admin
	# session is a cookie, and a browser throws away a Set-Cookie that arrives
	# from a different origin than the page. Served from the api service's own
	# domain the login round-trip returns 200 and the session still never
	# sticks. Proxying makes the cookie first-party, and removes CORS and its
	# preflight from every upload.
	#
	# handle_path strips the /api prefix, so /api/rpc reaches the api as /rpc.
	handle_path /api/* {
		reverse_proxy api.railway.internal:8787 {
			# Lessons are multi-GB and streamed; never buffer either direction.
			flush_interval -1
		}
	}

	handle {
		root * /srv/dist

		# Vite fingerprints everything under /assets, so those are immutable;
		# index.html must never be cached or a deploy keeps serving the old
		# bundle.
		@assets path /assets/*
		header @assets Cache-Control "public, max-age=31536000, immutable"
		header /index.html Cache-Control "no-cache"

		# TanStack Router owns every remaining path client-side: unknown paths
		# are routes, not 404s.
		try_files {path} /index.html
		file_server
	}
}
