# ml-service environment for the RunPod GPU worker (L4 24 GB).
# Copy to .env on the pod (or set as RunPod template env vars).

# --- GPU (fail loud) --------------------------------------------------------
DEVICE=cuda
# A pod that silently degrades to CPU bills ~20x the wall-clock; refuse instead.
REQUIRE_DEVICE=cuda
# Frames per predict() call. RF-DETR takes a batch, which is the main GPU
# throughput lever; raise while VRAM allows. On cuda the model is also JIT-traced
# in fp16 at exactly this batch size, so changing it changes the trace.
RFDETR_BATCH=16

# Serve as a TensorRT engine. OFF until you have run, on this pod:
#   uv run --extra tensorrt python tools/trt_parity.py <a-real-lesson.mp4>
# which proves the engine agrees with PyTorch AND tells you the real speedup.
# rfdetr ships TensorRT export but not TensorRT inference, so the serving path
# is ours and must be parity-checked before it is trusted. The engine is
# compiled for THIS GPU and TensorRT version and cached beside the weight; after
# changing GPU type, delete the .trt file and let it rebuild.
# Requires: uv sync --extra tensorrt
RFDETR_TENSORRT=false

# --- Detector ---------------------------------------------------------------
# The fine-tuned checkpoint, on the pod VOLUME: the container layer is
# recreated on every stop/start, so a workdir copy is re-uploaded each time.
RFDETR_WEIGHTS=/workspace/weights/rfdetr-medium.pth
# Trained-at resolution. Changing this rescales every box the model learned; it
# is not a free recall knob.
RFDETR_RESOLUTION=576

# --- Media path -------------------------------------------------------------
# The pod pulls video straight from object storage by presigned URL; only the
# storage host may be fetched (SSRF gate). Use the R2/MinIO public host.
MEDIA_URL_ALLOWLIST=media.example.com
# Scratch for downloaded videos (mount the pod volume here).
DATA_DIR=/workspace/data

# --- Results ----------------------------------------------------------------
DATABASE_URL=postgres://user:pass@app-host:5433/classroom
