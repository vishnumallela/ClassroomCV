# ml-service environment for the RunPod GPU worker (L4 24 GB).
# Copy to .env on the pod (or set as RunPod template env vars).

# --- GPU (fail loud, serve TensorRT) ----------------------------------------
DEVICE=cuda
# A pod that silently degrades to CPU bills ~20x the wall-clock; refuse instead.
REQUIRE_DEVICE=cuda
# One-time TensorRT fp16 export at first load (cached on the volume), ~5x
# throughput on the L4. Engines are per-GPU-model: re-export after changing
# GPU type (delete the .engine, restart).
TENSORRT_EXPORT=true
MODEL_NAME=auto
# Weight + engine cache on the pod VOLUME: the container layer is recreated on
# every stop/start, so a workdir cache re-downloads and re-exports each time.
WEIGHTS_DIR=/workspace/weights
# 1536 buys recall on small/half-occluded back-row people; the L4 has the
# headroom. Drop to 1280 only if throughput is short of the batch window.
IMGSZ=1536

# --- Media path -------------------------------------------------------------
# The pod pulls video straight from object storage by presigned URL; only the
# storage host may be fetched (SSRF gate). Use the R2/MinIO public host.
MEDIA_URL_ALLOWLIST=media.example.com
# Scratch for downloaded videos (mount the pod volume here).
DATA_DIR=/workspace/data

# --- Results ----------------------------------------------------------------
DATABASE_URL=postgres://user:pass@app-host:5433/classroom
